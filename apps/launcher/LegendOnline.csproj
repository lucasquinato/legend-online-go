<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>LegendOnline</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net40</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="LegendOnline.logo.ico" />
    <None Remove="LegendOnline.logo.png" />
    <EmbeddedResource Include="LegendOnline.logo.ico" LogicalName="LegendOnline.logo.ico" />
    <EmbeddedResource Include="LegendOnline.logo.png" LogicalName="LegendOnline.logo.png" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Compile Include="../updater/ReleaseWire.cs" Link="Update/ReleaseWire.cs" />
    <Compile Include="../../.local/build/UpdateTrust.cs" Link="Update/UpdateTrust.cs" Condition="Exists('../../.local/build/UpdateTrust.cs')" />
  </ItemGroup>
</Project>
