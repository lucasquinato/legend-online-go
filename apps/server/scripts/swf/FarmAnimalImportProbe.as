package {
 import flash.display.Sprite;import flash.display.Loader;import flash.system.LoaderContext;import flash.system.ApplicationDomain;import flash.net.URLLoader;import flash.net.URLRequest;import flash.events.Event;import flash.events.UncaughtErrorEvent;import flash.utils.getDefinitionByName;import flash.utils.setTimeout;
 public class MountRuntimeProbe extends Sprite {
  private var plans:Array;private var domain:ApplicationDomain;private var libs:Array=[];private var requests:Array=[];private var fixture:String;
  public function MountRuntimeProbe(){domain=new ApplicationDomain(ApplicationDomain.currentDomain);loaderInfo.uncaughtErrorEvents.addEventListener("uncaughtError",err);var u:URLLoader=new URLLoader();requests.push(u);u.addEventListener("complete",function(e:Event):void{var job:Object=JSON.parse(u.data);plans=job.files;fixture=job.battleFixture;next();});u.load(new URLRequest("http://127.0.0.1:18883/plan"));}
  private function log(s:String):void{var u:URLLoader=new URLLoader();requests.push(u);u.load(new URLRequest("http://127.0.0.1:18883/log?text="+encodeURIComponent(s)));}
  private function quit():void{setTimeout(function():void{var c:Object=getDefinitionByName("flash.desktop.NativeApplication");c.nativeApplication.exit(0);},500);}
  private function err(e:UncaughtErrorEvent):void{e.preventDefault();log("error "+e.error);quit();}
  private function next():void{if(!plans.length){log("verified farm.view.FarmAnimalItem "+domain.getDefinition("farm.view.FarmAnimalItem"));test();return;}var p:String=plans.shift();var l:Loader=new Loader();libs.push(l);l.uncaughtErrorEvents.addEventListener("uncaughtError",err);l.contentLoaderInfo.addEventListener("complete",function(e:Event):void{log("loaded "+p);next();});var ctx:LoaderContext=new LoaderContext(false,domain);ctx["allowCodeImport"]=true;var u:URLLoader=new URLLoader();requests.push(u);u.dataFormat="binary";u.addEventListener("complete",function(e:Event):void{l.loadBytes(u.data,ctx);});u.load(new URLRequest(p));}
  private function test():void{var u:URLLoader=new URLLoader();requests.push(u);u.dataFormat="binary";u.addEventListener("complete",function(e:Event):void{try{
   var View:Class=domain.getDefinition("farm.view.FarmAnimalItem") as Class;var Info:Class=domain.getDefinition("com.pickgliss.loader.data.LoaderInfo") as Class;
   var view:Object=new View(null,0,0,[]);libs.push(view);var loader:Loader=new Loader();view._loader=loader;libs.push(loader);loader.uncaughtErrorEvents.addEventListener("uncaughtError",err);
   loader.contentLoaderInfo.addEventListener("complete",function(e:Event):void{try{var count:int=0;for each(var name:String in loader.contentLoaderInfo.applicationDomain.getQualifiedDefinitionNames()){if(name.indexOf("asset.farmanimal.")==0||name.indexOf("asset.farmanimal::")==0){var C:Class=loader.contentLoaderInfo.applicationDomain.getDefinition(name) as Class;var animation:Object=new C();libs.push(animation);count++;}}if(count<1)throw new Error("No animal animations instantiated");log("farm-animal-native-import-passed "+count);quit();}catch(error:Error){log("error "+error+" "+error.getStackTrace());quit();}});
   try{view.__onComplete(new Info(),u.data);}catch(failure:Error){if(failure.errorID==3226){log("baseline-farm-animal-3226-reproduced");quit();return;}throw failure;}
  }catch(error:Error){log("error "+error+" "+error.getStackTrace());quit();}});u.load(new URLRequest(fixture));}
 }
}
