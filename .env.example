# Configuração de referência do repositório PRIVADO. Contém chaves privadas por decisão do mantenedor.
# O projeto procura .env na raiz; se ausente, lê este arquivo inteiro.
# Variáveis já definidas no ambiente têm prioridade. Não há mistura entre os dois arquivos.
# Antes de publicar este repositório, remover e substituir as chaves, inclusive no histórico Git.

# Motor do servidor: tutorial = jogo local; online = gateway de captura; replay = diagnóstico legado.
SERVER_MODE=tutorial

# Motor local dinâmico do tutorial; capture reproduz o cenário capturado.
TUTORIAL_ENGINE=dynamic

# Interface de rede do HTTP. Use 0.0.0.0 para acesso externo.
HTTP_HOST=127.0.0.1

# Porta HTTP para launcher, cadastro, assets e atualizações.
HTTP_PORT=18080

# Origem HTTP pública anunciada ao cliente, sem barra final.
PUBLIC_ORIGIN=http://127.0.0.1:18080

# Interface do socket TCP do jogo e da política Flash.
GAME_HOST=127.0.0.2

# Porta TCP do protocolo do jogo.
GAME_PORT=15004

# Porta de política de sockets Flash; o cliente tradicional usa 843.
POLICY_PORT=843

# IP ou DNS que o cliente usa para conectar ao TCP.
ADVERTISED_GAME_HOST=127.0.0.2

# Servidor remake para captura e fallback de assets ainda não coletados; não exige chave.
UPSTREAM_ORIGIN=https://servidor.legendremake.com

# Host TCP remoto, usado somente no modo online.
UPSTREAM_GAME_HOST=servidor.legendremake.com

# Porta TCP remota do gateway de captura.
UPSTREAM_GAME_PORT=5004

# Timeout configurado do upstream em milissegundos.
UPSTREAM_TIMEOUT_MS=120000

# Dados descartáveis, relativos a apps/server: contas, progresso e cache reconstruível.
DATA_DIR=data

# Grava pacotes HTTP/TCP no modo online; mantenha false no jogo local.
CAPTURE_PACKETS=false

# Assets: cache-first = local, remake e OAS; offline = somente acervo local; online = consulta remota.
RESOURCE_MODE=cache-first

# live serve os módulos de desenvolvimento; stable exige uma distribuição publicada.
CLIENT_RELEASE_CHANNEL=live

# Fuso de calendário, eventos e virada de dia do jogo.
GAME_TIME_ZONE=America/Sao_Paulo

# Diagnóstico: IDs dos módulos de montaria desabilitados, separados por vírgula. Vazio habilita todos.
DISABLE_MOUNT_MODULES=

# Chave RSA privada PEM em Base64 da autenticação Flash. A pública é derivada pelo servidor; não contém contas ou senhas.
GAME_AUTH_PRIVATE_KEY_

# Chave RSA privada PEM em Base64 para assinar atualizações. Deve corresponder a client/manifests/update-public.xml; conservar enquanto existirem launchers distribuídos.
RELEASE_SIGNING_PRIVATE_KEY_
